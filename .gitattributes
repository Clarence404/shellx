# Normalize all text files to LF on commit (cross-platform standard).
# Git will convert on checkout only if the local core.autocrlf setting
# asks for it — we don't: eol=lf means always store and check out as LF.
* text=auto eol=lf

# Binary files — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.icns binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
